        "function": "Format",
        "requirement": { "CheckFunction": "FormatJSON", "ColumnName": "{entity}", "Path": "$" }
    },
    "{entity} MUST conform to KeyValueFormat requirements.": {
        "function": "Format",
        "requirement": { "CheckFunction": "FormatKeyValue", "ColumnName": "{entity}" }
