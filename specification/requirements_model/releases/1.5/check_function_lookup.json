        "function": "Type",
        "requirement": { "CheckFunction": "TypeDecimal", "ColumnName": "{entity}" }
    },
    "{entity} MUST NOT be null.": {
        "function": "Nullability",
        "requirement": { "CheckFunction": "CheckNotValue", "ColumnName": "{entity}", "Value": null }
    },
    "{entity} SHOULD NOT be null.": {
        "function": "Nullability",
        "requirement": { "CheckFunction": "CheckNotValue", "ColumnName": "{entity}", "Value": null }
    },
    "{entity} MAY be null.": {
        "function": "Nullability",
        "requirement": { "CheckFunction": "CheckValue", "ColumnName": "{entity}", "Value": null }
